generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String?
  email      String     @unique
  password   String
  role       Role       @default(DELIVERY)
  business   Business?  @relation("BusinessUsers", fields: [businessId], references: [id])
  businessId String?
  ownedBusinesses   Business[] @relation("BusinessOwner")
  deleted   Boolean  @default(false)
  createdAt  DateTime @default(now())
  active Boolean @default(true)

  updatedAt  DateTime @updatedAt
}

model Business {
  id          String   @id @default(cuid())
  name        String
  industry    String
  email       String   @unique
  phone       String?
  country     String
  city        String
  address     String
  currency    String
  logo        String?
  subscriptionPrice Float? @default(0)
  subscriptionPlan  String? @default("Basic")
  active      Boolean  @default(true)

  ownerId     String?
  owner       User?     @relation("BusinessOwner", fields: [ownerId], references: [id])

  users       User[]   @relation("BusinessUsers")
  invoices    Invoice[]
  
  deleted Boolean @default(false)

 deletedAt   DateTime?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
}

enum Role {
   SUPER_ADMIN
  BUSINESS_ADMIN
  ACCOUNTANT
  STOREKEEPER
  CASHIER
  DELIVERY
}



model Notification {
  id         String   @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  message    String
  type       String   // EXPIRING_SOON, EXPIRED, PAYMENT_CONFIRMED
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
}





model Invoice {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id])

  amount      Float
  method      PaymentMethod
  period      BillingPeriod
  paidAt      DateTime      @default(now())
  nextDueDate DateTime

  createdAt   DateTime      @default(now())
}

enum PaymentMethod {
  CASH
  OMT
  WISH
  BANK
  OTHER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}